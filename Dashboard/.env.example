# Só é preciso no seu computador: para "npm run build" e para ligar "npm run dev" com o Supabase de verdade
# (sem este arquivo, o "npm run dev" usa um banco de teste local).
# Copie para ".env" (mesma pasta) e preencha. O .env nunca vai para o GitHub.
# Na Vercel, cadastre os mesmos nomes em Settings > Environment Variables.
#
# Onde achar: Supabase > seu projeto > Project Settings > API

# Endereço do projeto, ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chave PÚBLICA ("anon" / "publishable"). NUNCA use a "service_role" / "secret".
SUPABASE_ANON_KEY=

# Endereço público da Loja, ex.: https://minha-loja.vercel.app
# Usado no e-mail de redefinição de senha que o Dashboard envia aos clientes.
URL_LOJA=
