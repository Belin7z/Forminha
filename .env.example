# Só é preciso para rodar "npm run build" NESTA pasta, no seu computador.
# (Para ligar tudo com "npm run dev", o .env fica na pasta Dashboard.)
# Copie para ".env" (mesma pasta) e preencha. O .env nunca vai para o GitHub.
# Na Vercel, cadastre os mesmos nomes em Settings > Environment Variables.
#
# Onde achar: Supabase > seu projeto > Project Settings > API

# Endereço do projeto, ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chave PÚBLICA ("anon" / "publishable"). NUNCA use a "service_role" / "secret".
SUPABASE_ANON_KEY=
